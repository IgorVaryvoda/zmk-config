#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

&mt {
    flavor = "tap-preferred";
    tapping_term_ms = <200>;
};

/ {
    combos {
        compatible = "zmk,combos";

        combo_esc {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp ESC>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
        &kp Q       &kp W               &kp E                   &kp R      &kp T        &kp Y            &kp U               &kp I            &kp O             &kp P
        &kp A  &mt LALT S  &mt LEFT_CONTROL D        &mt LEFT_SHIFT F      &kp G        &kp H     &mt LSHIFT J  &mt LEFT_CONTROL K  &mt RIGHT_ALT L  &kp SINGLE_QUOTE
 &mt LSHIFT Z       &kp X               &kp C                   &kp V      &kp B        &kp N            &kp M           &kp COMMA          &kp DOT         &kp SLASH
                                               &mt LEFT_CONTROL SPACE  &lt 1 TAB  &lt 2 ENTER  &lt 3 BACKSPACE
            >;
        };

        left_layer {
            bindings = <
       &kp N1        &kp N2            &kp N3           &kp N4      &kp N5     &kp N6        &kp N7  &kp NUMBER_8     &kp N9    &kp N0
 &kp LEFT_GUI  &kp LEFT_ALT  &kp LEFT_CONTROL   &kp LEFT_SHIFT    &kp HASH  &kp MINUS  &kp CAPSLOCK        &kp UP    &kp DEL  &kp HOME
      &kp ESC     &kp TILDE   &kp NON_US_BSLH  &kp NON_US_HASH  &kp TILDE2  &kp MINUS      &kp LEFT      &kp DOWN  &kp RIGHT   &kp END
                                                         &mo 1    &kp LGUI   &kp RGUI         &mo 2
            >;
        };

        right_layer {
            bindings = <
   &kp EXCL       &kp AT  &kp HASH   &kp DLLR  &kp PRCNT  &kp CARET      &kp AMPS  &kp KP_MULTIPLY  &kp LPAR   &kp RPAR
   &kp HASH    &kp QMARK  &kp FSLH  &kp COLON   &kp SEMI  &kp MINUS  &kp KP_EQUAL         &kp LBRC  &kp RBRC   &kp BSPC
 &kp LSHIFT  &kp KP_PLUS  &kp LBKT   &kp RBKT   &kp BSLH  &kp UNDER      &kp LEFT         &kp DOWN    &kp UP  &kp RIGHT
                                        &mo 3  &kp LCTRL  &kp SPACE         &mo 2
            >;
        };

        tri_layer {
            bindings = <
     &kp N1      &kp N2      &kp N3  &kp N4  &kp N5  &trans     &trans             &trans      &trans  &trans
     &kp F1      &kp F2      &kp F3  &kp F4  &kp F5  &trans  &kp PG_UP    &kp K_VOLUME_UP  &kp K_MUTE  &trans
 &bt BT_CLR  &bt BT_NXT  &bt BT_PRV  &kp F6  &kp F7  &trans  &kp PG_DN  &kp K_VOLUME_DOWN      &trans  &trans
                                     &trans  &trans  &trans     &trans
            >;
        };
    };
};
