#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

&mt {
    flavor = "tap-preferred";
    tapping_term_ms = <200>;
};

/ {
    combos {
        compatible = "zmk,combos";

        combo_esc {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp ESC>;
        };

        tol4 {
            bindings = <&to 4>;
            key-positions = <32 33>;
        };

        tol1 {
            bindings = <&to 0>;
            key-positions = <30 31>;
        };
    };

    behaviors {
        bs: bs {
            compatible = "zmk,behavior-tap-dance";
            label = "BS";
            #binding-cells = <0>;
            bindings =
                <&kp BACKSPACE>,
                <&mo 3>;

            tapping-term-ms = <150>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
         &kp Q       &kp W               &kp E                   &kp R      &kp T        &kp Y         &kp U               &kp I            &kp O                      &kp P
&mt LEFT_WIN A  &mt LALT S  &mt LEFT_CONTROL D        &mt LEFT_SHIFT F      &kp G        &kp H  &mt LSHIFT J  &mt LEFT_CONTROL K  &mt RIGHT_ALT L  &mt LEFT_WIN SINGLE_QUOTE
  &mt LSHIFT Z       &kp X               &kp C                   &kp V      &kp B        &kp N         &kp M           &kp COMMA          &kp DOT                  &kp SLASH
                                                &mt LEFT_CONTROL SPACE  &lt 1 TAB  &lt 2 ENTER           &bs
            >;
        };

        left_layer {
            bindings = <
      &kp N1         &kp N2            &kp N3           &kp N4      &kp N5     &kp N6           &kp N7   &kp NUMBER_8       &kp N9    &kp N0
&kp LEFT_GUI  &kp LC(LS(S))  &kp LEFT_CONTROL   &kp LEFT_SHIFT    &kp HASH   &kp LEFT         &kp DOWN         &kp UP    &kp RIGHT  &kp CAPS
     &kp ESC      &kp TILDE   &kp NON_US_BSLH  &kp NON_US_HASH  &kp TILDE2  &kp MINUS         &kp HOME  &kp PAGE_DOWN  &kp PAGE_UP   &kp END
                                                         &mo 1    &kp LGUI  &kp ENTER  &lt 3 BACKSPACE
            >;
        };

        right_layer {
            bindings = <
  &kp EXCL       &kp AT  &kp HASH   &kp DLLR  &kp PRCNT  &kp CARET      &kp AMPS        &kp STAR         &kp LPAR       &kp RPAR
  &kp HASH    &kp QMARK  &kp FSLH  &kp COLON   &kp SEMI   &kp LEFT      &kp DOWN          &kp UP        &kp RIGHT       &kp SEMI
&kp LSHIFT  &kp KP_PLUS  &kp LBKT   &kp RBKT   &kp BSLH  &kp MINUS     &kp EQUAL  &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp SEMICOLON
                                   &kp SPACE  &kp LCTRL  &kp ENTER  &lt 3 DELETE
            >;
        };

        tri_layer {
            bindings = <
    &kp N1      &kp F2      &kp F3  &kp F4  &kp F5             &kp F6            &kp F7             &kp F8      &kp F9  &kp F10
   &kp F11     &kp F12      &kp F3  &kp F4  &kp F5       &kp C_VOL_UP  &kp C_PLAY_PAUSE    &kp K_VOLUME_UP  &kp K_MUTE   &trans
&bt BT_CLR  &bt BT_NXT  &bt BT_PRV  &kp F6  &kp F7  &kp C_VOLUME_DOWN        &kp C_NEXT  &kp K_VOLUME_DOWN      &trans   &trans
                                    &trans  &tog 4             &trans            &trans
            >;
        };

        Layer__4 {
            bindings = <
&kp Q  &kp W  &kp E     &trans     &trans  &trans  &trans  &trans  &trans            &trans
&kp A  &kp S  &kp D      &kp F     &trans  &trans   &kp J   &kp K   &kp L  &kp SINGLE_QUOTE
&kp Z  &kp X  &kp C     &trans     &trans  &trans  &trans  &trans  &trans            &trans
                     &kp SPACE  &lt 1 TAB  &trans  &trans
            >;
        };
    };
};
